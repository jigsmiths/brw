#!/usr/bin/env bash
# Runs the same checks as CI.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "pre-commit: run gofmt -w on:" >&2
  echo "$unformatted" >&2
  exit 1
fi
if [ -n "$(go fix -diff ./...)" ]; then
  echo "pre-commit: run go fix ./..." >&2
  exit 1
fi
if git grep -nI -e "$(printf '\342\200\224')"; then
  echo "pre-commit: remove the em dashes above" >&2
  exit 1
fi
golangci-lint run ./...
go test -race ./...
